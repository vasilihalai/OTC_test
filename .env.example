# One gateway origin for all four backend services (auth, user-account,
# balance, financial) — api-integration.md §1.1. `accountType`
# (personal/business) travels as a request field now, not a different base
# URL — the old two-backend split (miniapp-auth-integration-spec.md) is gone.
# Only used when VITE_USE_REAL_API=true.
VITE_API_BASE_URL=

# Per-service overrides — leave unset to use VITE_API_BASE_URL for all four.
# §1.1: "keep separately configurable so a per-service base URL override is
# possible without touching call sites."
VITE_API_BASE_URL_AUTH=
VITE_API_BASE_URL_USER_ACCOUNT=
VITE_API_BASE_URL_BALANCE=
VITE_API_BASE_URL_FINANCIAL=

# base64(client_id:client_secret) for the auth-service endpoints declared
# `security: basicAuth` (/oauth2/otp, /oauth2/token, /oauth2/revoke,
# /oauth2/introspect) — api-integration.md §1.3. Shipping this inside the
# mini app bundle is a known-bad interim state (question B1); a loud console
# warning fires if this is set in a production build. Isolated to
# src/api/real/http/authClient.ts — nowhere else reads it.
VITE_AUTH_BASIC=

# Optional — sent as x-client-version on every real API call, so the backend
# can attribute reports to a build. Leave unset to omit the header.
VITE_APP_VERSION=

# Master switch: false/unset (default) runs entirely on mocks — auth, profile,
# balances, and withdrawals all resolve from src/api/mock/*. Set to true once
# the real endpoints in src/api/real/* are ready to hit. Deals stay mocked
# either way (api-integration.md §0 — OTC is now real, but wiring the nine
# commands/polling/status-mapping is a separate step not done yet; the
# ?scenario= dev switches for walking statuses stay useful either way).
VITE_USE_REAL_API=false

# Forces the in-app AppHeader pill (close/back) to render even inside real
# Telegram, where it's normally hidden in favor of the native BackButton.
# Useful for demos and design review.
VITE_FORCE_INAPP_HEADER=false
